{
  "name": "browser-audio-maintained-attest",
  "description": "Generate signed attestations for workflow artifacts",
  "version": "4.1.0",
  "author": "",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/actions/attest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/attest.git"
  },
  "bugs": {
    "url": "https://github.com/actions/attest/issues"
  },
  "keywords": [
    "actions",
    "attestation"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "format:write": "prettier --write **/*.ts",
    "format:check": "prettier --check **/*.ts",
    "lint:eslint": "eslint",
    "lint:markdown": "markdownlint --config .markdown-lint.yml ../README.md",
    "lint": "npm run lint:eslint && npm run lint:markdown",
    "package": "ncc build src/index.ts --license licenses.txt --stats-out dist/stats.json",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "http-cache-semantics": "file:../http-cache-semantics",
    "@actions/attest": "^3.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "@sigstore/oci": "^0.7.2",
    "csv-parse": "^7.0.1"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "undici@^6": "6.29.1",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "@sigstore/core": "3.2.1",
    "http-cache-semantics": "$http-cache-semantics",
    "ip-address": "10.7.4",
    "smol-toml": "1.9.1",
    "katex": "0.19.1",
    "glob@^10": "13.0.6",
    "re2js": "2.9.1"
  },
  "devDependencies": {
    "deepmerge": "file:../deepmerge",
    "@eslint/js": "10.0.1",
    "@jest/globals": "^30.4.1",
    "@sigstore/mock": "^0.13.0",
    "@types/jest": "^30.0.0",
    "@types/make-fetch-happen": "^10.0.4",
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.44.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^30.4.2",
    "js-yaml": "5.5.0",
    "markdownlint-cli": "0.50.0",
    "nock": "^13.5.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.65.0",
    "undici": "8.12.2"
  }
}
